#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node* prev;
    struct Node* next;
} Node;

// 1. 创建循环双向链表
void CreateList(Node** head, int arr[], int len) {
    *head = (Node*)malloc(sizeof(Node));
    if(*head == NULL) return;
    (*head)->prev = *head;
    (*head)->next = *head;
    
    Node* tail = *head;
    for(int i = 0; i<len; i++){
        Node* newNode = (Node*)malloc(sizeof(Node));
        if(newNode == NULL){
            return;
        }
        
        newNode->data = arr[i];
        newNode->prev = tail;
        newNode->next = *head;
        
        tail->next = newNode;
        (*head)->prev = newNode;
        tail = newNode;
    }
}

// 2. 正向遍历
void PrintForward(Node* head) {
    if(head == NULL) return;
    
    Node* p = head->next;
    while(p != head){
        printf("%d ", p->data);
        p = p->next;
    }
    printf("\n");
}

// 3. 反向遍历
void PrintBackward(Node* head) {
    if(head == NULL) return;
    
    Node* p = head->prev;
    while(p != head){
        printf("%d ", p->data);
        p = p->prev;
    }
    printf("\n");
}

// 4. 在 target 后插入 value
void InsertAfter(Node* head, int target, int value) {
    if(head == NULL) return;
    
    Node* p = head->next;
    while(p != head && p->data != target){
        p = p->next;
    }
    if(p == head) return; //没找到
        
    Node* newNode = (Node*)malloc(sizeof(Node));
    if(newNode == NULL){
        return;
    }
        
    newNode->data = value;
    newNode->next = p->next;
    newNode->prev = p;
        
    p->next->prev = newNode;
    p->next = newNode;
}

// 5. 删除值为 target 的节点
void DeleteNode(Node* head, int target) {
    if(head == NULL) return;
    
    Node* p = head->next;
    while(p !=head && p->data != target){
        p = p->next;
    }
    if(p == head) return; //没找到
    
    p->prev->next = p->next;
    p->next->prev = p->prev;
    free(p);
}

// 6. 释放全部节点
void FreeList(Node* head) {
    if(head == NULL) return;
    
    Node* tail = head->next;
    while(tail != head){
        Node* temp = tail;
        tail = tail->next;
        free(temp);
    }
    free(head);
}

int main() {
    int arr[] = {10, 20, 30, 40, 50};
    int n = sizeof(arr) / sizeof(arr[0]);

    Node* head = NULL;
    CreateList(&head, arr, n);

    if (head == NULL) {
        printf("创建失败！\n");
        return 1;
    }

    printf("初始链表：\n");
    PrintForward(head);
    PrintBackward(head);

    InsertAfter(head, 20, 25);
    printf("\n插入25后：\n");
    PrintForward(head);
    PrintBackward(head);

    DeleteNode(head, 40);
    printf("\n删除40后：\n");
    PrintForward(head);
    PrintBackward(head);

    InsertAfter(head, 50, 60);
    printf("\n插入60后：\n");
    PrintForward(head);
    PrintBackward(head);

    DeleteNode(head, 10);
    DeleteNode(head, 60);

    printf("\n删除10和60后：\n");
    PrintForward(head);
    PrintBackward(head);

    FreeList(head);
    head = NULL;

    printf("\n释放链表成功！\n");
    return 0;
}
