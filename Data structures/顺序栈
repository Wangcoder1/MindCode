#include <stdio.h>

#define MAX_SIZE 5

typedef struct {
    int data[MAX_SIZE];
    int top;
} Stack;

// 1. 初始化栈
void InitStack(Stack* s) {
    s->top = -1;
}

// 2. 判断栈空：空返回1，否则返回0
int IsEmpty(Stack* s) {
    return s->top == -1;
}

// 3. 判断栈满：满返回1，否则返回0
int IsFull(Stack* s) {
    return s->top == MAX_SIZE-1;
}

// 4. 入栈：成功返回1，失败返回0
int Push(Stack* s, int value) {
    if(IsFull(s)){
        return 0;
    }
    
    s->top++;
    s->data[s->top] = value;
    
    return 1;
}

// 5. 出栈：成功返回1，并通过 value 带出数据
int Pop(Stack* s, int* value) {
    if(IsEmpty(s)){
        return 0;
    }
    
    *value = s->data[s->top];
    s->top--;
    
    return 1;
}

// 6. 查看栈顶：成功返回1，并通过 value 带出数据
int Peek(Stack* s, int* value) {
    if(IsEmpty(s)){
        return 0;
    }
    
    *value = s->data[s->top];
    return 1;
}

int main(void) {
    Stack s;
    int value;

    InitStack(&s);

    Push(&s, 10);
    Push(&s, 20);
    Push(&s, 30);

    if (Peek(&s, &value)) {
        printf("当前栈顶：%d\n", value);
    }

    if (Pop(&s, &value)) {
        printf("出栈元素：%d\n", value);
    }

    if (Peek(&s, &value)) {
        printf("新的栈顶：%d\n", value);
    }

    Push(&s, 40);
    Push(&s, 50);
    Push(&s, 60);

    if (!Push(&s, 70)) {
        printf("入栈70失败：栈已满\n");
    }

    printf("依次出栈：");
    while (Pop(&s, &value)) {
        printf("%d ", value);
    }

    printf("\n");

    if (IsEmpty(&s)) {
        printf("栈已空\n");
    }

    return 0;
}


