#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node* next;
} Node;

void FreeList(Node* head);

// 1. 创建不带头节点的链表
Node* CreateList(int arr[], int len) {
    Node* head = NULL;
    Node* tail = NULL;
    for(int i = 0; i < len; i++){
        Node* newNode = (Node*)malloc(sizeof(Node));
        if(newNode == NULL){
            FreeList(head);
            return NULL;
        }
        
        newNode->data = arr[i];
        newNode->next = NULL;
        
        if(head == NULL){
            head = newNode;
            tail = newNode;
        }else{
            tail->next =newNode;
            tail = newNode;
        }
    }
    return head;
}

// 2. 打印链表
void PrintList(Node* head) {
    while(head != NULL){
        printf("%d ", head->data);
        head = head->next;
    }
    printf("\n");
}

// 3. 合并两个有序链表
Node* MergeLists(Node* a, Node* b) {
    Node dummy;    //临时虚拟头节点
    dummy.next = NULL;
    Node* tail = &dummy;
    
    while(a != NULL && b != NULL){
        if(a->data <= b->data){
            tail->next = a;
            a = a->next;
        }else{
            tail->next = b;
            b = b->next;
        }
        tail = tail->next;
    }
     //其中一个链表已经结束，直接接上另一个链表剩余的节点
     if(a != NULL){
         tail->next = a;
     }else{
         tail->next = b;
     }
     
     return dummy.next;
}

// 4. 删除倒数第 n 个节点
Node* RemoveNthFromEnd(Node* head, int n) {
    if(n <= 0){
        return head;
    }
    
    //创建虚拟头节点
    Node dummy;
    dummy.next = head;
    //创建快慢指针
    Node* fast = &dummy;
    Node* slow = &dummy;
    //让fast先走n+1步
    for(int i = 0; i <= n; i++){
        if(fast == NULL) return head;
        fast = fast->next;
    }
    //两个指针一起向后移动
    while(fast != NULL){
        slow = slow->next;
        fast = fast->next;
    }
    //slow指向待删除节点的前驱
    Node* target = slow->next;
    
    slow->next = target->next;
    free(target);
    return dummy.next;
}

// 5. 反转链表
Node* ReverseList(Node* head) {
    Node* pre = NULL;
    Node* cur = head;
    while(cur != NULL){
        Node* p = cur->next;
        cur->next = pre;
        pre = cur;
        cur = p;
    }
    return pre;
}

// 6. 释放链表
void FreeList(Node* head) {
    Node* p = head;
    while(p != NULL){
        Node* temp = p;
        p = p->next;
        free(temp);
    }
}

int main(void) {
    int arrA[] = {1, 3, 5};
    int arrB[] = {2, 4, 6};

    Node* a = CreateList(arrA, 3);

    if (a == NULL) {
    printf("创建链表A失败！\n");
    return 1;
    }

    Node* b = CreateList(arrB, 3);

    if (b == NULL) {
    printf("创建链表B失败！\n");
    FreeList(a);
    return 1;
    }

    printf("链表A：");
    PrintList(a);

    printf("链表B：");
    PrintList(b);

    Node* merged = MergeLists(a, b);

    // 原节点已归入 merged，后续统一释放
    a = NULL;
    b = NULL;

    printf("\n合并后：\n");
    PrintList(merged);

    merged = RemoveNthFromEnd(merged, 2);

    printf("\n删除倒数第2个节点后：\n");
    PrintList(merged);

    merged = ReverseList(merged);

    printf("\n反转后：\n");
    PrintList(merged);

    FreeList(merged);

    printf("\n释放成功！\n");
    return 0;
}
